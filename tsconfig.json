{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["src/contracts/*"],
      "@system/*": ["src/system/*"],
      "@agent/*": ["src/system/teraApi-frontend/agent/*"],
      "@device/*": ["src/system/teraApi-frontend/device/*"],
      "@video/*": ["src/system/teraApi-frontend/video/*"],
      "@auth/*": ["src/system/teraApi-frontend/auth/*"],
      "@ops/*": ["src/system/teraApi-frontend/ops/*"],
      "@observability/*": ["src/system/teraApi-frontend/observability/*"],
      "@analytics/*": ["src/system/teraApi-frontend/analytics/*"],
      "@docs/*": ["src/system/teraApi-frontend/docs/*"],
      "@services/*": ["src/infrastructure/api/adapters/*"],
      "@components/*": ["src/infrastructure/presentation/components/*"],
      "@types": ["src/domain/types"],
      "@types/*": ["src/domain/types/*"],
      "@lib/*": ["src/lib/*"],
      "@hooks/*": ["src/application/hooks/*"],
      "@contexts/*": ["src/contexts/*"],
      "@store/*": ["src/infrastructure/store/*"],
      "@generated/*": ["src/domain/generated/*"],
      "@mappers/*": ["src/infrastructure/api/mappers/*"],
      "@pages/*": ["src/pages/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@application/*": ["src/application/*"],
      "@domain/*": ["src/domain/*"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"]
}
